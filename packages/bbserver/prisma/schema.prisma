generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                   Int      @id @default(autoincrement())
  bankName             String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime? // nullable

  totalBalance         Decimal  @default(0.0)
  availableBalance     Decimal  @default(0.0)
  savingBalance        Decimal  @default(0.0)
  fixedDepositBalance  Decimal  @default(0.0)
  investmentBalance    Decimal  @default(0.0)
  holdBalance          Decimal  @default(0.0)

  transactionsFrom     Transaction[] @relation("FromAccount")
  transactionsTo       Transaction[] @relation("ToAccount")
}

model Transaction {
  id          Int                     @id @default(autoincrement())
  amount      Decimal
  depositor   String?
  description String
  type        TransactionType
  category    TransactionCategory?    @default(ETC)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  paymentType TransactionPaymentType?

  // 계좌 간 이체용 참조
  fromAccountId Int?
  toAccountId   Int?

  fromAccount   Account? @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount     Account? @relation("ToAccount", fields: [toAccountId], references: [id])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionCategory {
  FOOD
  DRINK
  RECHARGE
  CREDIT_CARD_PAYMENT
  SALARY
  SAVINGS
  EMERGENCY_FUND
  INVESTMENT
  SHOPPING
  INSURANCE
  TRANSPORT
  SUBSCRIBE
  PHONE
  DUES
  PRESENT
  LOAN_REPAYMENT
  ETC
}

enum TransactionPaymentType {
  CREDIT_CARD
  CHECK_CARD
  KAKAO_PAY
  APPLE_PAY
  NAVER_PAY
  TOSS
  BANK_TRANSFER
  CASH
  POINT
  GIFT_CARD
  VIRTUAL_ACCOUNT
  CRYPTO
  ETC
}
