{
  "name": "Budget-book",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:ci": "pnpm build",
    "lint": "turbo run lint",
    "lint:ci": "pnpm lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "test:ci": "pnpm --filter bbserver exec jest --runInBand",
    "version-packages": "changeset version",
    "format": "turbo run format",
    "graph:turbo": "node dot/scripts/gen-turbo-graph.js",
    "graph:merge": "node dot/scripts/merge-graph.js",
    "graph": "pnpm run graph:turbo && pnpm run graph:merge"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.14.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.0.0",
    "prettier": "^3.2.5",
    "sass": "^1.87.0",
    "ts-node": "^10.9.2",
    "turbo": "latest",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
